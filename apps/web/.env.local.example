# Firebase Admin SDK (server-only, back/lib/firebase-admin.ts).
# Copy this file to .env.local (already gitignored) and fill in real values
# from a service account key generated for the nextfood-76bc3 project.
# Never commit .env.local.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Local development with the Firebase Auth Emulator (recommended) ---
# Run `firebase emulators:start --only auth,firestore` from the repo root,
# then set these two so both the Admin SDK (server) and the Client SDK
# (browser, /login only) talk to the emulator instead of a real project.
# With these set, FIREBASE_PROJECT_ID/CLIENT_EMAIL/PRIVATE_KEY above are not
# needed for Auth.
#
# To create a local test user once the emulator is running, use the Emulator
# UI at http://localhost:4000/auth, or the REST API:
#   curl -X POST "http://localhost:9099/identitytoolkit.googleapis.com/v1/accounts:signUp?key=any" \
#     -H "Content-Type: application/json" \
#     -d '{"email":"owner@acai.test","password":"senha123","returnSecureToken":true}'
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-nextfood
